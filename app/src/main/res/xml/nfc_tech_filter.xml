<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NFC-A (ISO 14443-3A, MIFARE, NTAG) -->
    <tech-list>
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>
    <!-- NFC-B (ISO 14443-3B) -->
    <tech-list>
        <tech>android.nfc.tech.NfcB</tech>
    </tech-list>
    <!-- NFC-F (Sony FeliCa, ISO 18092) -->
    <tech-list>
        <tech>android.nfc.tech.NfcF</tech>
    </tech-list>
    <!-- NFC-V (ISO 15693, ICODE SLIX, ST25TV, ST25DV) -->
    <tech-list>
        <tech>android.nfc.tech.NfcV</tech>
    </tech-list>
    <!-- ISO-DEP (ISO 14443-4, MIFARE DESFire, SmartCards) -->
    <tech-list>
        <tech>android.nfc.tech.IsoDep</tech>
    </tech-list>
    <!-- MIFARE Classic -->
    <tech-list>
        <tech>android.nfc.tech.MifareClassic</tech>
    </tech-list>
    <!-- MIFARE Ultralight -->
    <tech-list>
        <tech>android.nfc.tech.MifareUltralight</tech>
    </tech-list>
    <!-- NDEF formatted -->
    <tech-list>
        <tech>android.nfc.tech.Ndef</tech>
    </tech-list>
    <!-- NDEF formatable -->
    <tech-list>
        <tech>android.nfc.tech.NdefFormatable</tech>
    </tech-list>
</resources>
